# Placement Drive Attendance System - Backend Configuration

# MongoDB Atlas or Local MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/attendrive?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/attendrive

# Port for the Express API server
PORT=5000

# Optional Access PIN (if left blank/omitted, PIN verification is disabled)
ACCESS_PIN=

# JWT Authentication Configuration
JWT_SECRET=attendrive_secret_jwt_key_2025_secure_token
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (e.g., http://localhost:5173 or https://your-app.netlify.app)
FRONTEND_URL=http://localhost:5173

# Environment (development | production)
NODE_ENV=development
