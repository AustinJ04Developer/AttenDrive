# AttenDrive Frontend Environment Variables
# In local development, the Vite dev server proxies '/api' to http://localhost:5000:
VITE_API_URL=/api

# For Netlify Production Deployment:
# 1. In Netlify Site Dashboard > Site configuration > Environment variables:
#    Add: VITE_API_URL = https://your-backend-service.onrender.com/api (or your hosted API domain)
# 2. In your backend server configuration (server/.env), set:
#    FRONTEND_URL = https://your-site-name.netlify.app
